# ========================================================
# Unified Gitignore for MERN Full-Stack Template (Client & Server)
# ========================================================

# Dependencies
node_modules/
client/node_modules/
server/node_modules/
/.pnp
.pnp.js

# Environment Variables (Keep secrets private, use .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
client/.env
client/.env.local
server/.env
server/.env.local

# Production & Build Outputs
dist/
dist-ssr/
build/
client/dist/
client/build/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
.nyc_output/

# Cache directories
.eslintcache
.stylelintcache
.vite/
client/.vite/
.turbo/

# Uploaded Files
server/secure_uploads/resumes/*
!server/secure_uploads/resumes/.gitkeep
server/uploads/*
!server/uploads/.gitkeep
!server/uploads/companies/.gitkeep


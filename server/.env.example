# Server Port (Render will provide process.env.PORT automatically)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=development

# MongoDB Atlas connection string (Remember to whitelist 0.0.0.0/0 on Atlas Network Access for Render)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/careerhub?retryWrites=true&w=majority

# Strong secret key for signing JWT tokens (use a random string >= 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32_chars_minimum

# Allowed frontend client URL for CORS (e.g., https://your-careerhub.vercel.app)
CLIENT_URL=http://localhost:5173

# Optional: Set to 'true' only if you want to allow in-memory fallback during production troubleshooting
ALLOW_IN_MEMORY_FALLBACK=false
